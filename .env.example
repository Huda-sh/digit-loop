# Copy to .env.local and fill from your Supabase project settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# The unlisted lead-view path segment. Change it to something only the lead knows.
# The route is /lead-<token>; auth still gates the data.
VITE_LEAD_TOKEN=3f2a91
